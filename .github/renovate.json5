{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests', ':semanticCommitTypeAll(chore)'],
  timezone: 'Asia/Shanghai',
  schedule: ['before 9am on monday'],
  prConcurrentLimit: 5,
  labels: ['dependencies'],
  packageRules: [
    {
      description: 'JDK 只跟随 25 LTS',
      matchDatasources: ['docker'],
      matchPackageNames: ['eclipse-temurin'],
      allowedVersions: '/^25\\./',
    },
    {
      description: 'Maven 保持 3.x',
      matchManagers: ['maven-wrapper'],
      allowedVersions: '<4',
    },
    {
      description: 'Postgres / Redis 大版本需要迁移数据，只接收同大版本更新',
      matchDatasources: ['docker'],
      matchPackageNames: ['postgres', 'redis'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      matchPackageNames: ['org.springframework.boot:**'],
      groupName: 'spring-boot',
    },
    {
      matchPackageNames: ['org.testcontainers:**'],
      groupName: 'testcontainers',
    },
    {
      matchPackageNames: ['com.google.errorprone:**', 'com.uber.nullaway:**'],
      groupName: 'errorprone',
    },
    {
      matchPackageNames: ['com.diffplug.spotless:**', 'com.palantir.javaformat:**'],
      groupName: 'spotless',
    },
    {
      matchPackageNames: ['software.amazon.awssdk:**'],
      groupName: 'aws-sdk',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchManagers: ['custom.regex'],
      matchFileNames: ['.github/workflows/**', 'Makefile'],
      groupName: 'github actions',
    },
    {
      matchManagers: ['docker-compose', 'custom.regex'],
      matchFileNames: ['docker/**', '**/*.java'],
      groupName: 'docker images',
    },
    {
      matchPackageNames: [
        'org.springframework.boot:**',
        'org.testcontainers:**',
        'com.google.errorprone:**',
        'com.uber.nullaway:**',
        'com.diffplug.spotless:**',
        'com.palantir.javaformat:**',
        'software.amazon.awssdk:**',
      ],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
  ],
  'docker-compose': {
    managerFilePatterns: ['/^docker/.+\\.ya?ml$/'],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Makefile$/', '/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: [
        '_IMAGE(?: :=|:) (?<depName>[^:\\s/]+/[^:\\s]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Makefile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION\\s*:?=\\s*v?(?<currentValue>\\S+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)[^/]+\\.java$/'],
      matchStrings: ['_IMAGE = "(?<depName>[^:"]+):(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'docker',
    },
  ],
}
