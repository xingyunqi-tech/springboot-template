<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.xingyunqi.template</groupId>
        <artifactId>springboot-template</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>
    <description>JaCoCo 聚合覆盖率报告</description>

    <dependencies>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-json</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-common-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-views</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-app</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>openapi-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>generator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <excludes>
                                <exclude>**/contract/api/**</exclude>
                                <exclude>**/contract/model/**</exclude>
                                <exclude>**/cli/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ci-gate</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>${root.dir}/ci/CiGate.java</argument>
                                        <argument>${root.dir}</argument>
                                        <argument>${project.reporting.outputDirectory}/jacoco-aggregate/jacoco.xml</argument>
                                        <argument>0.80</argument>
                                        <argument>0.70</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
