<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.xingyunqi.template</groupId>
        <artifactId>springboot-template</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>template-contract</artifactId>
    <description>由 openapi/nestjs-baseline.json 生成的 *Api 接口与 DTO</description>

    <properties>
        <codegen.input>${project.build.directory}/openapi/codegen.json</codegen.input>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>template-views</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.xingyunqi.template</groupId>
            <artifactId>openapi-tools</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>codegen-input</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <mainClass>tech.xingyunqi.template.tools.openapi.CodegenInput</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${root.dir}/openapi/nestjs-baseline.json</argument>
                                <argument>${root.dir}/openapi/scope.yaml</argument>
                                <argument>${root.dir}/openapi/codegen-overlay.yaml</argument>
                                <argument>${codegen.input}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>contract</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <inputSpec>${codegen.input}</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <apiPackage>tech.xingyunqi.template.contract.api</apiPackage>
                            <modelPackage>tech.xingyunqi.template.contract.model</modelPackage>
                            <templateDirectory>${project.basedir}/src/main/templates</templateDirectory>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <typeMappings>
                                <typeMapping>DateTime=Instant</typeMapping>
                            </typeMappings>
                            <importMappings>
                                <importMapping>Instant=java.time.Instant</importMapping>
                            </importMappings>
                            <schemaMappings>
                                <schemaMapping>User=tech.xingyunqi.template.views.UserView</schemaMapping>
                                <schemaMapping>LoginResponseDto=tech.xingyunqi.template.views.LoginResponseView</schemaMapping>
                            </schemaMappings>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJackson3>true</useJackson3>
                                <useRecords>true</useRecords>
                                <useBeanValidation>false</useBeanValidation>
                                <useResponseEntity>false</useResponseEntity>
                                <openApiNullable>false</openApiNullable>
                                <documentationProvider>none</documentationProvider>
                                <annotationLibrary>none</annotationLibrary>
                                <useTags>true</useTags>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <sourceFolder>src/gen/java</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
